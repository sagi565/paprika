# Copy to .env and change every "change-me".

APP_PORT=8080

POSTGRES_DB=paprika
POSTGRES_USER=paprika
POSTGRES_PASSWORD=change-me

# Long random string; signs the login cookie.
SECRET_KEY=change-me
# The site's login password.
ADMIN_PASSWORD=change-me
# true once the site is served over HTTPS.
COOKIE_SECURE=false

# Fill an empty database with demo kindergartens.
SEED_DEMO=true

# Public site address; Grow redirects and notifies to it (must be HTTPS for live mode).
PUBLIC_URL=

# mock = simulated Grow (safe to play with). live = real Grow.
GROW_MODE=mock
# Sandbox: https://sandbox.meshulam.co.il/api/light/server/1.0
# Production: https://secure.meshulam.co.il/api/light/server/1.0
GROW_BASE_URL=
GROW_USER_ID=
GROW_PAGE_CODE=
GROW_API_KEY=
# Long random string; part of the webhook URLs given to Grow.
GROW_WEBHOOK_KEY=
