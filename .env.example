# Copy to .env and change every "change-me".

APP_PORT=8080

POSTGRES_DB=paprika
POSTGRES_USER=paprika
POSTGRES_PASSWORD=change-me

# Long random string; signs the login cookie.
SECRET_KEY=change-me
# The site's login password.
ADMIN_PASSWORD=change-me
# true once the site is served over HTTPS.
COOKIE_SECURE=false

# Fill an empty database with demo kindergartens.
SEED_DEMO=true

# mock = simulated Grow (safe to play with). live = real Grow (needs the TODOs in backend/app/services/grow.py).
GROW_MODE=mock
GROW_BASE_URL=
GROW_USER_ID=
GROW_PAGE_CODE=
GROW_API_KEY=
